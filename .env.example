# Copy to .env.local (development) and/or .env.production (builds). Both are git-ignored.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
#   Authorized JavaScript origins: http://localhost:5173 and your deployed URL.
#   Enable the "Google Drive API" for the project, and add your Google account as a test user.
VITE_GOOGLE_CLIENT_ID=

# Names the two profiles start with on a fresh install (each can be renamed later in Settings).
VITE_PARTNER_1_NAME=
VITE_PARTNER_2_NAME=

# Optional: an existing Drive folder to use as the archive root. Only used if the app can write to it;
# otherwise it creates an "Our Little World" folder in My Drive.
VITE_DRIVE_ROOT_FOLDER_ID=
